// Generated by lsc from sandCodec.ts

datatype Option<T> = None | Some(value: T)

function NormalizeSliceIndex(n: nat, i: int): int
  ensures 0 <= NormalizeSliceIndex(n, i) <= n as int
{
  if i < 0 then
    if n as int + i < 0 then 0 else n as int + i
  else if i > n as int then n as int
  else i
}

function SafeSlice<T>(s: seq<T>, lo: int, hi: int): seq<T>
  ensures |SafeSlice(s, lo, hi)| <= |s|
{
  var lo' := NormalizeSliceIndex(|s|, lo);
  var hi' := NormalizeSliceIndex(|s|, hi);
  if hi' < lo' then [] else s[lo'..hi']
}

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype PlacedObject = PlacedObject(id: int, kind: ObjectKind, item: string, x: int, y: int, angle: int, size: int, base: Option<int>, variant: int, wild: Option<bool>, found: Option<bool>)

datatype ObjectKind = rock | driftwood | shell | seaglass | trash | seaweed | flag | conch | sanddollar | starfish | bottle | nautilus | beachball | sandals | bucket | coral | coconut | deckchair | parasol | surfboard | sandcastle | beachhut | lighthouse | tikitorch | palmtree | lifeguardtower | bonfire | hammock | towel | footprints

datatype ObjectsToSaveResult = ObjectsToSaveResult(keep: seq<PlacedObject>, dropped: int)

function yoursOf(objects: seq<PlacedObject>): seq<PlacedObject>
{
  Std.Collections.Seq.Filter((o: PlacedObject) => (match o.wild { case Some(i_value) => (i_value != true) case None => true }), objects)
}

function wildOf(objects: seq<PlacedObject>): seq<PlacedObject>
{
  Std.Collections.Seq.Filter((o: PlacedObject) => (match o.wild { case Some(i_value) => (i_value == true) case None => false }), objects)
}

function objectsToSave(objects: seq<PlacedObject>): ObjectsToSaveResult
{
  var mine := yoursOf(objects);
  var wild := wildOf(objects);
  var all := (mine + wild);
  var keep := SafeSlice(all, 0, MAX_OBJECTS);
  ObjectsToSaveResult(keep, MathMax(0, (|mine| - MAX_OBJECTS)))
}

lemma objectsToSave_ensures(objects: seq<PlacedObject>)
  ensures (|objectsToSave(objects).keep| <= MAX_OBJECTS)
  ensures (|objectsToSave(objects).keep| == MathMin(|objects|, MAX_OBJECTS))
  ensures (objectsToSave(objects).dropped == MathMax(0, (|yoursOf(objects)| - MAX_OBJECTS)))
  ensures forall i: nat :: ((i < |objectsToSave(objects).keep|) ==> (i < |yoursOf(objects)|) ==> (objectsToSave(objects).keep[i] == yoursOf(objects)[i]))
  ensures forall i: nat :: ((i < |objectsToSave(objects).keep|) ==> (objectsToSave(objects).keep[i] in objects))
{
  SplitByWild(objects);
  var all := yoursOf(objects) + wildOf(objects);
  var keep := objectsToSave(objects).keep;
  assert keep == SafeSlice(all, 0, MAX_OBJECTS);
  assert keep == all[..MathMin(|all|, MAX_OBJECTS)];
  forall i: nat | i < |keep|
    ensures keep[i] in objects
  {
    assert keep[i] == all[i];
    assert all[i] in yoursOf(objects) || all[i] in wildOf(objects);
  }
}

// every thing is yours or the sea's, never both, and neither list holds
// anything that wasn't there
lemma SplitByWild(objects: seq<PlacedObject>)
  ensures |yoursOf(objects)| + |wildOf(objects)| == |objects|
  ensures forall o :: o in yoursOf(objects) ==> o in objects
  ensures forall o :: o in wildOf(objects) ==> o in objects
  decreases |objects|
{
  reveal Std.Collections.Seq.Filter();
  if |objects| > 0 {
    SplitByWild(objects[1..]);
    assert yoursOf(objects) == (if objects[0].wild != Some(true) then [objects[0]] else []) + yoursOf(objects[1..]);
    assert wildOf(objects) == (if objects[0].wild == Some(true) then [objects[0]] else []) + wildOf(objects[1..]);
  }
}

const MAX_OBJECTS: int := 2000
