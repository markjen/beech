method SetToSeq<T>(s: set<T>) returns (res: seq<T>)
  ensures forall x :: x in s <==> x in res
  ensures |res| == |s|
  ensures forall i, j :: 0 <= i < j < |res| ==> res[i] != res[j]
{
  var remaining := s;
  res := [];
  while remaining != {}
    invariant remaining <= s
    invariant forall x :: x in res <==> (x in s && x !in remaining)
    invariant |res| + |remaining| == |s|
    invariant forall i, j :: 0 <= i < j < |res| ==> res[i] != res[j]
    decreases remaining
  {
    var x :| x in remaining;
    res := res + [x];
    remaining := remaining - {x};
  }
}

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype Short = Short(item: string, need: int, have: int)

function bagLeft(owned: map<string, int>, elsewhere: map<string, int>, item: string): int
{
  MathMax(0, ((if (item in owned) then (var i_oc0_val := owned[item]; i_oc0_val) else 0) - (if (item in elsewhere) then (var i_oc1_val := elsewhere[item]; i_oc1_val) else 0)))
}

lemma bagLeft_ensures(owned: map<string, int>, elsewhere: map<string, int>, item: string)
  ensures (bagLeft(owned, elsewhere, item) >= 0)
{
}

method shortfallUnsorted(need: map<string, int>, owned: map<string, int>, elsewhere: map<string, int>, free: set<string>) returns (res: seq<Short>)
  ensures forall i: nat :: ((i < |res|) ==> (((((res[i].item in need) && !((res[i].item in free))) && ((res[i].item in need) && (var i_value := need[res[i].item]; (i_value == res[i].need)))) && (res[i].have == bagLeft(owned, elsewhere, res[i].item))) && (res[i].need > res[i].have)))
  ensures forall k :: ((k in need) ==> !((k in free)) ==> ((k in need) && (var i_value := need[k]; (i_value > 0))) ==> ((k in need) && (var i_value := need[k]; (i_value > bagLeft(owned, elsewhere, k)))) ==> exists i: nat :: ((i < |res|) && (res[i].item == k)))
  ensures forall i: nat, j: nat :: ((i < j) ==> (j < |res|) ==> (res[i].item != res[j].item))
{
  var out: seq<Short> := [];
  var i_item_keys := SetToSeq(need.Keys);
  var i_item_idx := 0;
  while i_item_idx < |i_item_keys|
    invariant (i_item_idx <= |i_item_keys|)
    invariant forall i :: 0 <= i < |out| ==> out[i].item in need && out[i].item !in free && out[i].need == need[out[i].item] && out[i].have == bagLeft(owned, elsewhere, out[i].item) && out[i].need > out[i].have
    invariant forall i :: 0 <= i < |out| ==> out[i].item in i_item_keys[..i_item_idx]
    invariant forall k :: k in i_item_keys[..i_item_idx] && k !in free && need[k] > 0 && need[k] > bagLeft(owned, elsewhere, k) ==> k in ItemsOf(out)
    invariant forall i, j :: 0 <= i < j < |out| ==> out[i].item != out[j].item
  {
    var item := i_item_keys[i_item_idx];
    var n := need[item];
    if !(((n <= 0) || (item in free))) {
      var i_t0 := bagLeft(owned, elsewhere, item);
      var have := i_t0;
      if (n > have) {
        ghost var before := out;
        out := (out + [Short(item, n, have)]);
        assert out[|out| - 1].item == item;
        ItemsOfAppend(before, Short(item, n, have));
      }
    }
    assert i_item_keys[..i_item_idx + 1] == i_item_keys[..i_item_idx] + [item];
    i_item_idx := i_item_idx + 1;
  }
  assert i_item_keys[..i_item_idx] == i_item_keys;
  return out;
}

ghost function ItemsOf(s: seq<Short>): set<string>
{
  set i | 0 <= i < |s| :: s[i].item
}

lemma ItemsOfAppend(s: seq<Short>, x: Short)
  ensures ItemsOf(s + [x]) == ItemsOf(s) + {x.item}
{
  forall k | k in ItemsOf(s)
    ensures k in ItemsOf(s + [x])
  {
    var i :| 0 <= i < |s| && s[i].item == k;
    assert (s + [x])[i].item == k;
  }
  assert (s + [x])[|s|].item == x.item;
}
