function promoBonusCents(promo: Promo, packBucks: int): int
  requires (packBucks >= 0)
{
  if (promo.kind == "bucks") then
    (MathMax(0, promo.value) * 10)
  else
    (JSFloorDiv((packBucks * MathMin(100, MathMax(0, promo.value))), 100) * 10)
}

