      case None =>
        match promo.maxUses {
          case Some(i_promo_maxUses_val) =>
            if (promo.uses >= i_promo_maxUses_val) then
              Some("that code has been used up")
            else
              match promo.appliesTo {
                case Some(i_promo_appliesTo_val) =>
                  if (i_promo_appliesTo_val != productId) then
                    Some("that code is not for this product")
                  else
                    None
                case None =>
                  None
              }
          case None =>
            match promo.appliesTo {
              case Some(i_promo_appliesTo_val) =>
