datatype Option<T> = None | Some(value: T)

function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype Promo = Promo(code: string, kind: string, value: int, appliesTo: Option<string>, maxUses: Option<int>, uses: int, active: bool, expiresAt: Option<int>)

function promoBlocked(promo: Promo, productId: string, now: int): Option<string>
{
