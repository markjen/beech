// Generated by lsc from referrals.ts

datatype Option<T> = None | Some(value: T)

function ladderAt(rank: int): Option<string>
{
  if ((rank < 1) || (rank > REWARD_CAP)) then
    None
  else
    if (rank <= |LADDER|) then
      Some(LADDER[(rank - 1)])
    else
      Some(LADDER_REST)
}

lemma ladderAt_ensures(rank: int)
  ensures ((match ladderAt(rank) { case Some(i_) => false case None => true }) <==> ((rank < 1) || (rank > REWARD_CAP)))
  ensures ((rank >= 1) ==> (rank <= |LADDER|) ==> (rank <= REWARD_CAP) ==> (match ladderAt(rank) { case Some(i_value) => (i_value == LADDER[(rank - 1)]) case None => false }))
  ensures ((rank > |LADDER|) ==> (rank <= REWARD_CAP) ==> (match ladderAt(rank) { case Some(i_value) => (i_value == LADDER_REST) case None => false }))
  ensures ((match ladderAt(rank) { case Some(i_value) => (i_value == "beach") case None => false }) <==> (rank == LADDER_BEACH_RANK))
{
}

const REWARD_CAP: int := 10

const LADDER: seq<string> := ["parasol", "surfboard", "beach", "tikitorch", "sandcastle"]

const LADDER_REST: string := "starfish"

const LADDER_BEACH_RANK: int := 3
