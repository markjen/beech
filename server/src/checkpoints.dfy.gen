method SetToSeq<T>(s: set<T>) returns (res: seq<T>)
  ensures forall x :: x in s <==> x in res
  ensures |res| == |s|
  ensures forall i, j :: 0 <= i < j < |res| ==> res[i] != res[j]
{
  var remaining := s;
  res := [];
  while remaining != {}
    invariant remaining <= s
    invariant forall x :: x in res <==> (x in s && x !in remaining)
    invariant |res| + |remaining| == |s|
    invariant forall i, j :: 0 <= i < j < |res| ==> res[i] != res[j]
    decreases remaining
  {
    var x :| x in remaining;
    res := res + [x];
    remaining := remaining - {x};
  }
}

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype Short = Short(item: string, need: int, have: int)

function bagLeft(owned: map<string, int>, elsewhere: map<string, int>, item: string): int
{
  MathMax(0, ((if (item in owned) then (var i_oc0_val := owned[item]; i_oc0_val) else 0) - (if (item in elsewhere) then (var i_oc1_val := elsewhere[item]; i_oc1_val) else 0)))
}

lemma bagLeft_ensures(owned: map<string, int>, elsewhere: map<string, int>, item: string)
  ensures (bagLeft(owned, elsewhere, item) >= 0)
{
}

function countIn(m: map<string, int>, item: string): int
{
  if (item in m) then
    var i_oc2_val := m[item];
    i_oc2_val
  else
    0
}

const FREE_ITEMS: set<string> := {"rock", "driftwood", "shell", "seaglass", "trash", "seaweed", "cowrie", "flag", "footprints"}

method shortfallUnsorted(need: map<string, int>, owned: map<string, int>, elsewhere: map<string, int>) returns (res: seq<Short>)
  ensures forall i: nat :: ((i < |res|) ==> (((((res[i].item in need) && !((res[i].item in FREE_ITEMS))) && ((res[i].item in need) && (var i_value := need[res[i].item]; (i_value == res[i].need)))) && (res[i].have == bagLeft(owned, elsewhere, res[i].item))) && (res[i].need > res[i].have)))
  ensures forall k :: ((k in need) ==> !((k in FREE_ITEMS)) ==> ((k in need) && (var i_value := need[k]; (i_value > 0))) ==> ((k in need) && (var i_value := need[k]; (i_value > bagLeft(owned, elsewhere, k)))) ==> exists i: nat :: ((i < |res|) && (res[i].item == k)))
  ensures forall i: nat, j: nat :: ((i < j) ==> (j < |res|) ==> (res[i].item != res[j].item))
{
  var out: seq<Short> := [];
  var i_item_keys := SetToSeq(need.Keys);
  var i_item_idx := 0;
  while i_item_idx < |i_item_keys|
    invariant (i_item_idx <= |i_item_keys|)
  {
    var item := i_item_keys[i_item_idx];
    var n := need[item];
    if !(((n <= 0) || (item in FREE_ITEMS))) {
      var i_t0 := bagLeft(owned, elsewhere, item);
      var have := i_t0;
      if (n > have) {
        out := (out + [Short(item, n, have)]);
      }
    }
    i_item_idx := i_item_idx + 1;
  }
  return out;
}

method nothingGrew(placed: map<string, int>, stored: map<string, int>) returns (res: bool)
  ensures ((res == true) <==> forall k :: ((k in placed) ==> ((k in placed) && (var i_value := placed[k]; (i_value <= countIn(stored, k))))))
{
  var i_item_keys := SetToSeq(placed.Keys);
