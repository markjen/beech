  ensures forall i: nat :: ((i < |res|) ==> ((((res[i].item in placed) && ((res[i].item in placed) && (var i_value := placed[res[i].item]; (i_value == res[i].need)))) && (res[i].have == MathMax(countIn(stored, res[i].item), (countIn(owned, res[i].item) - countIn(elsewhere, res[i].item))))) && (res[i].need > res[i].have)))
  ensures forall k :: ((k in placed) ==> ((k in placed) && (var i_value := placed[k]; (i_value > MathMax(countIn(stored, k), (countIn(owned, k) - countIn(elsewhere, k)))))) ==> exists i: nat :: ((i < |res|) && (res[i].item == k)))
  ensures forall i: nat, j: nat :: ((i < j) ==> (j < |res|) ==> (res[i].item != res[j].item))
  ensures forall i: nat :: ((i < |res|) ==> ((res[i].item in placed) && (var i_value := placed[res[i].item]; (i_value > countIn(stored, res[i].item)))))
