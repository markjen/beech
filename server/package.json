{
  "name": "beech-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Accounts and saved beaches for beech: a Cloudflare Worker + D1, which also serves the built web app.",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "migrate:local": "wrangler d1 migrations apply beech --local --persist-to .wrangler/state",
    "migrate:remote": "wrangler d1 migrations apply beech --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings test/auth.test.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
