{
  "name": "beech-server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE",
  "description": "beech backend: serves the web app and /api (accounts, saved beaches, neighbors). Node + Hono + Postgres; runs on Cloud Run.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/server.js",
    "dev": "tsc -p tsconfig.json && node build/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:state": "vitest run test/stateMachines",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.19.18",
    "hono": "4.13.17",
    "jose": "6.2.15",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
