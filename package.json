{
  "name": "beech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A calm beach sand-and-waves toy for web and mobile, built with Babylon.js.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@babylonjs/core": "8.56.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
