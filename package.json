{
  "name": "beech",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "description": "A calm beach sand-and-waves toy for web and mobile, built with Babylon.js.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "beach-file": "node scripts/beach-file.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:sim": "node scripts/perf-sim.mjs",
    "bundle:server": "node scripts/bundle-server.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cap:sync": "npm run cap:sync:android && npm run build && cap sync ios",
    "cap:sync:android": "node scripts/sync-android.mjs",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run cap:sync:android && cap open android",
    "server:dev": "npm run build:accounts && cd server && npm run build && DEV_AUTH=1 PORT=8787 ADMIN_DEV_PORT=8788 BEECH_APP_URL=http://localhost:8787 GAME_URL=http://localhost:8787 ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost node build/server.js",
    "build:accounts": "VITE_ACCOUNTS=1 VITE_DEV_AUTH=1 vite build",
    "build:steam": "VITE_ACCOUNTS=1 VITE_PLATFORM=steam VITE_API_URL=https://play.beech.games tsc --noEmit && VITE_ACCOUNTS=1 VITE_PLATFORM=steam VITE_API_URL=https://play.beech.games vite build",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:accounts": "node scripts/account-e2e.mjs",
    "e2e:neighbors": "node scripts/neighbors-e2e.mjs",
    "e2e:shore": "node scripts/shore-e2e.mjs",
    "e2e:beaches": "node scripts/beaches-e2e.mjs",
    "e2e:piers": "node scripts/piers-e2e.mjs",
    "e2e:sections": "node scripts/sections-e2e.mjs",
    "e2e:sandrows": "node scripts/sand-rows-e2e.mjs",
    "e2e:leaderboard": "node scripts/leaderboard-e2e.mjs",
    "e2e:checkpoints": "node scripts/checkpoints-e2e.mjs",
    "e2e:live": "node scripts/live-e2e.mjs",
    "e2e:sandbox": "node scripts/sandbox-e2e.mjs",
    "e2e:invites": "node scripts/invites-e2e.mjs",
    "e2e:inbox": "node scripts/inbox-e2e.mjs",
    "e2e:copy": "node scripts/copy-e2e.mjs",
    "e2e:push": "node scripts/push-e2e.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "8.56.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/geolocation": "8.2.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.2",
    "@capgo/capacitor-social-login": "8.7.6",
    "@capgo/native-purchases": "8.9.6",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
